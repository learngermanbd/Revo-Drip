
# Large backup archive
/bagisto.zip

# Secrets
/bagisto/.env
/bagisto/.env.*
!/bagisto/.env.example

# Dependencies and generated files
/bagisto/vendor/
/bagisto/node_modules/
/bagisto/storage/logs/
/bagisto/storage/framework/cache/
/bagisto/storage/framework/sessions/
