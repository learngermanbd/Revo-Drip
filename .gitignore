!/bagisto/storage/app/public/**/*.jpg
!/bagisto/storage/app/public/**/*.jpeg
!/bagisto/storage/app/public/**/*.webp
!/bagisto/storage/app/public/**/*.svg
!/bagisto/storage/app/public/**/*.gif

